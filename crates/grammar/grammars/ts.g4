WS        : [ \t\r\n]+ -> skip ;
LINE_CMT  : '//' ~[\n]* -> comment ;
BLOCK_CMT : '/*' ( !'*/' . )* '*/' -> comment ;
TEMPLATE  : '`' ( '\\' . / !'`' !'${' . )* '`' ;
THEAD     : '`' ( '\\' . / !'`' !'${' . )* '${' ;
STRING    : '"' ( '\\' . / ~["\\] )* '"' ;
SINGLE    : '\'' ( '\\' . / ~['\\] )* '\'' ;
ARROW     : '=>' ;
IDENT     : [a-zA-Z_$] [a-zA-Z0-9_$]* ;
NUMBER    : [0-9] [0-9a-zA-Z_$]* ;
LBRACE    : '{' ;
RBRACE    : '}' ;
LPAREN    : '(' ;
RPAREN    : ')' ;
LBRACK    : '[' ;
RBRACK    : ']' ;
REGEX     : '/' ![/*] ( '\\' . / '[' ( '\\' . / ~[\]\\\n] )* ']' / ~[/\\\n] )+ '/' [a-zA-Z]* -> regex ;
OTHER     : . ;

unit : item ;

item : importItem / exportItem / fnItem / typeItem / interfaceItem / classItem / declItem / ambient / control / assignItem / callItem / lineItem / scope / bare ;
importItem : 'import' 'type'? tail -> item ;
exportItem : 'export' ( 'default' )? ( fnItem / typeItem / interfaceItem / classItem / declItem / shipItem / callItem / lineItem ) / 'export' 'default' phrase ;
shipItem : 'type'? LBRACE ( port ( ',' port )* ','? )? RBRACE ( 'from' lit )? ';'? -> item ;
port : 'type'? ( IDENT 'as' name / name ) ;
ambient : 'declare' 'module' lit LBRACE item* RBRACE ';'? -> item ;
fnItem : flags 'function' '*'? name tpar? fpar ( typed / simpleReturn / scope / sign ) -> item ;
tpar : '<' ( tpar / !'>' . )* '>' ;
fpar : LPAREN prop seat mates RPAREN / pgroup ;
mates : ( ',' prop more )* frest ;
prop : ( ( 'public' / 'private' / 'protected' / 'readonly' / 'override' ) !':' !'?' !',' !RPAREN )* ;
more : spread? bind '?'? ( ':' stype dflt? / preset ) -> param ;
seat : spread? bind '?'? ( ':' stype dflt? / preset ) -> receiver ;
spread : '.' '.' '.' ;
bind : IDENT / group / bgroup ;
preset : ( !',' !RPAREN inner )* ;
dflt : '=' preset ;
stype : ( sgroup / ( !',' !RPAREN !'=' . ) )* ;
sgroup : targ / tpg / tbg / tgr ;
targ : '<' ( targ / sgroup / !'>' !RPAREN !RBRACK !RBRACE !';' . )* '>' ;
tpg : LPAREN tin* RPAREN ;
tbg : LBRACK tin* RBRACK ;
tgr : LBRACE entry? ( ',' entry / tkey / tskip / tlo )* RBRACE ;
tkey : key ( '?' / '!' )? !!( ':' / tpar? LPAREN ) ;
tskip : ( '?' / ':' ) tlo ;
tin : tpg / tbg / tgr / tbolt / lambda / ( !RPAREN !RBRACK . ) ;
tlo : tgr / tpg / tbg / tbolt / lambda / ( !LBRACE !RBRACE !LBRACK !RBRACK !LPAREN !RPAREN . ) ;
tbolt : ARROW tscope ;
tscope : LBRACE tst* RBRACE -> scope ;
tst : tscope / lead trec / ( !RBRACE . ) ;
trec : LBRACE entry? ( ',' entry / tst )* RBRACE ;
thead : ( tpg / tbg / ( !LBRACE !RBRACE !';' . ) )* ;
note : ':' ( tbolt / tpg / tbg / tgr / ( !'=' !';' !LBRACE !RBRACE !LBRACK !RBRACK !LPAREN !RPAREN . ) )* ;
cast : ( 'as' / 'satisfies' ) cunit ( ( '|' / '&' ) cunit )* ;
cunit : ( 'keyof' / 'typeof' / 'readonly' / 'unique' )* ( 'new'? tpar? tpg !!ARROW ( ARROW !LBRACE cunit )? / tbg / tgr / targ / lit / IDENT ( '.' IDENT )* targ? ) tbg* ;
vtarg : '<' ( targ / sgroup / !'>' !RPAREN !RBRACK !RBRACE !';' !'?' !'=' !'!' !( '&' '&' ) !( '|' '|' ) . )* '>' !!LPAREN ;
angle : '<' ( !'<' / !!( tpar tpg ) ) cunit '>' ;
frest : inner* ;
typeItem : 'type' name ( !';' tlo )* ';'? -> item ;
interfaceItem : 'interface' name thead tgr -> item ;
classItem : 'abstract'? 'class' title? head body -> item ;
title : !'extends' !'implements' name ;
body : LBRACE member* RBRACE ;
member : ';' / decorator* ( still / method / field ) / stray ;
decorator : '@' path pgroup? ;
still : 'static' scope ;
method : mods key '?'? tpar? fpar ( typed / fullReturn / scope / sign ) -> item ;
field : mods key ( '?' / '!' )? ( ':' ftype )? ( '=' init / ';' / !!RBRACE ) -> item ;
mods : ( flag !LPAREN !'=' !';' !':' !'?' !'!' !'<' !RBRACE )* '*'? ;
flag : 'static' / 'async' / 'get' / 'set' / 'public' / 'private' / 'protected' / 'readonly' / 'abstract' / 'override' / 'declare' / 'accessor' ;
key : 'constructor' / '#'? name / lit / bgroup ;
fullReturn : ':' fill scope !'>' !'|' !'&' ;
fill : ( !LBRACE !RBRACE !';' . )+ ;
sign : ( ':' ftype )? ';' ;
ftype : ( sgroup / !'=' !';' !RBRACE . )* ;
stray : !RBRACE ( group / pgroup / bgroup / . ) -> loose ;
declItem : decl !'enum' declarator ( ',' declarator )* ';'? -> item ;
declarator : ( name / bgroup / group ) note? init ;
callItem : !arrow path tpar? pgroup tail -> item ;
lineItem : line tail -> item ;
assignItem : path bgroup* assign tail -> item ;
bare : !stop phrase ;
phrase : !!start ( !';' loose )+ ';'? -> item ;
start : IDENT / lit / REGEX / LPAREN / LBRACK / LBRACE / '!' / '~' / '+' / '-' / '<' ;
stop : LBRACE / 'function' / 'class' / 'async' 'function' / decl / 'import' / 'export' / 'declare' / 'abstract' / 'enum' / 'namespace' / 'module' / 'interface' / 'type' / 'if' / 'else' / 'while' / 'for' / 'do' / 'switch' / 'case' / 'default' / 'try' / 'catch' / 'finally' / 'with' / IDENT ':' ;
assign : '=' !'=' / ( '*' '*' / '?' '?' / '&' '&' / '|' '|' / '<' '<' / '>' '>' '>' / '>' '>' / '+' / '-' / '*' / '%' / '&' / '|' / '^' ) '=' ;

name : IDENT -> word ;
flags : ( 'async' )* ;
decl : 'const' / 'let' / 'var' ;
line : 'await' / 'return' / 'throw' / 'break' / 'continue' ;
simpleReturn : ':' plain scope ;
typed : ':' yields scope ;
plain : ( !LBRACE !RBRACE !';' . )* ;
path : mark / IDENT ( '.' IDENT )* ;
mark : 'Deno' '.' 'test' -> test ;

stmt : control / fnItem / lambda / typeItem / interfaceItem / classItem / declItem / markupHole / arrow / cast / vtarg / angle / scope / lead record / template / ( !RBRACE . ) ;
lead : LPAREN / LBRACK / ',' / ':' / '=' / '?' / '&' / '|' / '.' / 'return' / 'throw' / 'yield' ;
record : LBRACE ( entry / fkey )? ( ',' ( entry / fkey ) / stmt )* RBRACE ;
control : ifExpr / whileExpr / forExpr / switchExpr / tryExpr ;
ifExpr : 'if' LPAREN probe RPAREN ( scope / limb ) elseTail / 'if' pgroup ( scope / limb ) elseTail / 'if' head scope elseTail ;
probe : subject '=' '=' '='? lit ;
subject : IDENT ( '.' IDENT )* -> probe ;
lit : STRING / SINGLE / TEMPLATE / template / NUMBER / 'true' / 'false' / 'null' / 'undefined' ;
template : THEAD tint* ( TMID tint* )* TTAIL ;
tint : template / arrow / cast / vtarg / angle / classExpr / markupHole / pgroup / bgroup / group / bolt / lambda / ( !TMID !TTAIL . ) ;
elseTail : ( 'else' ( ifExpr / scope / limb ) )? ;
limb : ( control / declItem / !';' stmt ( !';' !cut stmt )* ';'? ) -> scope ;
cut : 'if' / 'else' / 'for' / 'while' / 'do' / 'switch' / 'try' / decl ;
whileExpr : 'while' pgroup ( scope / limb ) / 'while' head scope ;
forExpr : 'for' 'await'? pgroup ( scope / limb ) / 'for' head scope ;
switchExpr : 'switch' head cases ;
cases : LBRACE ( arm / stmt )* RBRACE -> scope ;
arm : ( 'case' ( template / !':' !LBRACE !RBRACE . )+ / 'default' ) ':' scope ;
tryExpr : 'try' scope catchTail finallyTail ;
catchTail : ( 'catch' head scope )? ;
finallyTail : ( 'finally' scope )? ;

scope : LBRACE stmt* RBRACE -> scope ;

init : '=' classExpr / classExpr / '=' lambda / lambda / ( !ARROW !';' !halt !',' loose )* ( ARROW blade )? ;
tail : ( !';' !halt loose )* ';'? ;
halt : 'function' / 'class' / 'async' 'function' / decl / 'import' / 'export' / 'declare' / 'abstract' / 'enum' / 'namespace' / 'module' / 'interface' / 'type' / 'if' / 'while' / 'for' / 'do' / 'switch' / 'try' / 'with' ;
classExpr : 'class' title? head body ;

head : headAtom* ;
headAtom : pgroup / bgroup / template / ( !LBRACE !RBRACE !';' . ) ;
pgroup : LPAREN inner* RPAREN ;
bgroup : LBRACK inner* RBRACK ;
inner : arrow / cast / vtarg / angle / classExpr / markupHole / template / pgroup / bgroup / group / bolt / lambda / ( !RPAREN !RBRACK . ) ;

loose : arrow / cast / vtarg / angle / markupHole / template / group / pgroup / bgroup / bolt / lambda / ( !LBRACE !RBRACE !LBRACK !RBRACK !LPAREN !RPAREN . ) ;
group : LBRACE ( entry / fkey )? ( ',' ( entry / fkey ) / loose )* RBRACE ;
fkey : key !!( ':' ( arrow / lambda ) ) ;
entry : mods key '?'? tpar? fpar ( ':' yields )? scope !!( ',' / RBRACE ) -> item ;
yields : ( '|' / '&' )? link ( ( '|' / '&' ) link )* ;
link : piece+ ;
piece : tpar / tpg / tbg / tgr !!( LBRACE / LBRACK / '|' / '&' ) / ( !LBRACE !RBRACE !';' !',' !'|' !'&' !'=' . ) ;
bolt : ARROW scope ;
blade : scope ;
markupHole : '<' '>' markKid* '<' '/' '>' / '<' markTag markAttr* '/' '>' / '<' markTag markAttr* '>' markKid* '<' '/' markTag? '>' -> loose ;
markTag : IDENT ( '.' IDENT )* ;
markAttr : markName ( '=' markVal )? / LBRACE ( !RBRACE . )* RBRACE ;
markName : IDENT ( '-' IDENT )* ;
markVal : STRING / SINGLE / LBRACE ( !RBRACE . )* RBRACE ;
markKid : markupHole / LBRACE ( !RBRACE . )* RBRACE / ( !'<' !LBRACE !RBRACE . ) ;
arrow : !!( flags tpar? ( skim ret? / IDENT ) ARROW ) flags tpar? ( fpar ret? / ray ) ARROW blade? -> item ;
ray : IDENT -> receiver ;
ret : ':' ( targ / sgroup / !ARROW !',' !';' !'=' !LBRACE !RBRACE !RPAREN !RBRACK . )+ ;
skim : LPAREN ( skim / !RPAREN . )* RPAREN ;
lambda : flags 'function' '*'? name? tpar? fpar ( typed / simpleReturn / scope ) -> item ;
