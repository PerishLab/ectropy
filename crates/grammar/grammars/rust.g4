WS        : [ \t\r\n]+ -> skip ;
LINE_CMT  : '//' ~[\n]* -> comment ;
BLOCK_CMT : '/*' ( !'*/' . )* '*/' -> comment ;
RAW8      : 'r########"' ( !'"########' . )* '"########' ;
BRAW8     : 'br########"' ( !'"########' . )* '"########' ;
RAW7      : 'r#######"' ( !'"#######' . )* '"#######' ;
BRAW7     : 'br#######"' ( !'"#######' . )* '"#######' ;
RAW6      : 'r######"' ( !'"######' . )* '"######' ;
BRAW6     : 'br######"' ( !'"######' . )* '"######' ;
RAW5      : 'r#####"' ( !'"#####' . )* '"#####' ;
BRAW5     : 'br#####"' ( !'"#####' . )* '"#####' ;
RAW4      : 'r####"' ( !'"####' . )* '"####' ;
BRAW4     : 'br####"' ( !'"####' . )* '"####' ;
RAW3      : 'r###"' ( !'"###' . )* '"###' ;
BRAW3     : 'br###"' ( !'"###' . )* '"###' ;
RAW2      : 'r##"' ( !'"##' . )* '"##' ;
BRAW2     : 'br##"' ( !'"##' . )* '"##' ;
RAW1      : 'r#"' ( !'"#' . )* '"#' ;
BRAW1     : 'br#"' ( !'"#' . )* '"#' ;
RAW0      : 'r"' ( !'"' . )* '"' ;
BRAW0     : 'br"' ( !'"' . )* '"' ;
STRING    : '"' ( '\\' . / ~["\\] )* '"' ;
CHAR      : '\'' ( '\\' . / ~['\\] ) '\'' ;
IDENT     : [a-zA-Z_] [a-zA-Z0-9_]* ;
NUMBER    : [0-9] [0-9a-zA-Z_]* ;
LBRACE    : '{' ;
RBRACE    : '}' ;
LPAREN    : '(' ;
RPAREN    : ')' ;
LBRACK    : '[' ;
RBRACK    : ']' ;
OTHER     : . ;

unit : item ;

item : outer* vis core ;
outer : sign / ignore / plain ;
sign : '#' '!'? LBRACK gate RBRACK -> test ;
gate : 'cfg' LPAREN 'test' RPAREN / 'test' ;
ignore : '#' '!'? LBRACK 'ignore' ( '=' lit )? RBRACK -> test ;
plain : '#' '!'? LBRACK loose* RBRACK ;
vis : ( 'pub' pgroup? )? ;
core : modItem / nestItem / fnItem / structItem / foreignItem / makeItem / callItem / lineItem ;

modItem    : quals 'impl' head LBRACE unit* RBRACE -> item ;
nestItem   : quals ( 'trait' / 'mod' ) name head LBRACE unit* RBRACE -> item ;
fnItem     : quals 'fn' name fnTail -> item ;
fnTail : gen? fparams head ( scope / ';' ) / skew ( scope / ';' ) ;
gen : '<' genAtom* '>' ;
genAtom : gen / pgroup / bgroup / '-' '>' / ( !'>' !LPAREN . ) ;
fparams : LPAREN seat mates RPAREN / LPAREN sits mates RPAREN / LPAREN RPAREN ;
sits : '&'? ( '\'' IDENT )? 'mut'? 'self' ;
mates : ( ',' more )* ( ',' '.' '.' '.' )? ','? ;
more : outer* pattern ':' stype -> param ;
seat : outer* pattern ':' stype -> receiver ;
pattern : ( '&' 'mut'? )* ( path group / 'ref'? 'mut'? IDENT ( '@' pattern )? / pgroup / bgroup ) ;
stype : ( sgroup / ( !',' !RPAREN . ) )* ;
sgroup : pgroup / bgroup / gen ;
skew : head -> loose ;
structItem : quals ( 'struct' / 'enum' / 'union' ) name head structTail -> item ;
lineItem   : declItem / plainItem ;
declItem : declKw 'mut'? name ( !';' ( structLit / scope / pgroup / bgroup / ( !RBRACE !RBRACK !RPAREN . ) ) )* ';'? -> item ;
plainItem : lineKw ( !';' loose )* ';'? -> item ;
declKw : 'static' / 'type' / 'const' / 'mod' ;
name       : IDENT -> word ;
quals      : ( 'extern' STRING? / 'async' / 'unsafe' / 'safe' / 'const' / 'default' / 'move' )* ;
lineKw     : 'use' / 'extern' ;

foreignItem : 'unsafe'? 'extern' STRING? LBRACE ( unit / spill )* RBRACE -> item ;
spill : ( !RBRACE !unit loose )+ -> loose ;
makeItem : 'macro_rules' '!' name LBRACE arm* RBRACE -> item ;
arm : match '=' '>' spell ';'? ;
match : pgroup / bgroup / hold ;
spell : scope / pgroup / bgroup ;
hold : LBRACE loose* RBRACE ;
mbrace : LBRACE stmt* RBRACE ;
callItem : path '!' ( pgroup / bgroup / mbrace ) ';'? -> item ;

structTail : fields / ';' ;
fields : LBRACE member* RBRACE ;
member : outer* vis? name ( fields / !LBRACE ) membertail ;
membertail : ( !',' !RBRACE loose )* ','? ;

stmt : guard / nested / control / letStmt / typed / structLit / scope / stray / ( !RBRACE . ) ;
guard : '*' ( 'const' / 'mut' ) / '\'' IDENT ;
nested : outer* vis inCore ;
inCore : modItem / nestItem / fnItem / structItem / foreignItem / makeItem / declItem ;
stray : ( quals strayKw / 'unsafe'? 'extern' STRING? !!LBRACE ) -> loose ;
strayKw : ( 'struct' / 'enum' / 'union' / 'trait' / 'mod' / 'fn' / 'type' / 'static' ) IDENT / 'impl' ( IDENT / '<' ) / 'macro_rules' '!' ;
letStmt : 'let' 'mut'? name !!( '=' / ':' !':' / ';' ) ;
control : ifExpr / whileExpr / forExpr / loopExpr / matchExpr ;
ifExpr    : 'if' probe scope elseTail / 'if' head scope elseTail ;
probe : subject '=' '=' lit ;
subject : IDENT ( '.' IDENT )* -> probe ;
lit : STRING / CHAR / RAW0 / BRAW0 / RAW1 / BRAW1 / RAW2 / BRAW2 / RAW3 / BRAW3 / RAW4 / BRAW4 / RAW5 / BRAW5 / RAW6 / BRAW6 / RAW7 / BRAW7 / RAW8 / BRAW8 / 'b' CHAR / 'b' STRING / NUMBER / 'true' / 'false' ;
elseTail  : ( 'else' ( ifExpr / scope ) )? ;
whileExpr : 'while' head scope ;
forExpr   : 'for' head scope ;
loopExpr  : 'loop' scope ;
matchExpr : 'match' head scope ;

scope : LBRACE stmt* RBRACE -> scope ;
structLit : path LBRACE stmt* RBRACE -> literal ;
path : !reserved IDENT ( ':' ':' IDENT )* ;
reserved : 'as' / 'async' / 'await' / 'break' / 'const' / 'continue' / 'dyn' / 'else' / 'enum' / 'extern' / 'fn' / 'for' / 'if' / 'impl' / 'in' / 'let' / 'loop' / 'match' / 'mod' / 'move' / 'mut' / 'pub' / 'ref' / 'return' / 'static' / 'struct' / 'trait' / 'type' / 'unsafe' / 'use' / 'where' / 'while' ;
typed : '-' '>' ( sgroup / ( !LBRACE !RBRACE !';' !',' !'=' !RPAREN !RBRACK . ) )+ scope ;

head : headAtom* ;
headAtom : pgroup / bgroup / ( !LBRACE !RBRACE !';' !( '=' '>' ) . ) ;
pgroup : LPAREN inner* RPAREN ;
bgroup : LBRACK inner* RBRACK ;
inner  : pgroup / bgroup / scope / typed / structLit / ( !RPAREN !RBRACK . ) ;

loose : group / ( !LBRACE !RBRACE !LBRACK !RBRACK !LPAREN !RPAREN . ) ;
group : LBRACE loose* RBRACE / LBRACK loose* RBRACK / LPAREN loose* RPAREN ;
